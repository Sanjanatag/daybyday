# ─── Backend (Express + MongoDB) ───
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/streak-habits?retryWrites=true&w=majority&appName=Cluster0
HOST=127.0.0.1
PORT=3000

# ─── Frontend (Vite) — must start with VITE_ to reach the browser ───
# Use /api when frontend and API are on the same domain (recommended on Vercel)
VITE_API_BASE=/api

# Dev only: full API origin for Vite proxy (local)
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
API_HEALTH_URL=http://127.0.0.1:3000/api/health

# Dev only: Vite dev server
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_URL=http://localhost:5173

# Optional: Web Push (VAPID public key, safe to expose)
# VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
